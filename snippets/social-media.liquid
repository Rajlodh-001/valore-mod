{%- doc -%}
  Output a list of social media icons based on the social URL settings.

  @param {string} [layout] - either "list" or "block" (default to list)
{%- enddoc -%}

{%- capture social_media -%}
  {%- assign facebook_url = settings.social_facebook | default: shop.brand.metafields.social_links.facebook | default: 'https://www.facebook.com/profile.php?id=61571476015562' -%}
  {%- if facebook_url != blank -%}
    <li class="social-media__item branding-colors--facebook">
      <a href="{{ facebook_url }}" class="tap-area" target="_blank" rel="noopener" aria-label="Facebook">
        {%- render 'icon' with 'facebook' -%}
      </a>
    </li>
  {%- endif -%}

  {%- assign twitter_url = settings.social_twitter | default: shop.brand.metafields.social_links.twitter -%}
  {%- if twitter_url != blank -%}
    <li class="social-media__item branding-colors--twitter">
      <a href="{{ twitter_url }}" class="tap-area" target="_blank" rel="noopener" aria-label="Twitter">
        {%- render 'icon' with 'twitter' -%}
      </a>
    </li>
  {%- endif -%}

  {%- assign instagram_url = settings.social_instagram | default: shop.brand.metafields.social_links.instagram | default: 'https://www.instagram.com/valoreaoe/' -%}
  {%- if instagram_url != blank -%}
    <li class="social-media__item branding-colors--instagram">
      <a href="{{ instagram_url }}" class="tap-area" target="_blank" rel="noopener" aria-label="Instagram">
        {%- render 'icon' with 'instagram' -%}
      </a>
    </li>
  {%- endif -%}

  {%- assign youtube_url = settings.social_youtube | default: shop.brand.metafields.social_links.youtube | default: 'https://www.youtube.com/@valoreaoe/' -%}
  {%- if youtube_url != blank -%}
    <li class="social-media__item branding-colors--youtube">
      <a href="{{ youtube_url }}" class="tap-area" target="_blank" rel="noopener" aria-label="YouTube">
        {%- render 'icon' with 'youtube' -%}
      </a>
    </li>
  {%- endif -%}

  {%- assign vimeo_url = settings.social_vimeo | default: shop.brand.metafields.social_links.vimeo -%}
  {%- if vimeo_url != blank -%}
    <li class="social-media__item branding-colors--vimeo">
      <a href="{{ vimeo_url }}" class="tap-area" target="_blank" rel="noopener" aria-label="Vimeo">
        {%- render 'icon' with 'vimeo' -%}
      </a>
    </li>
  {%- endif -%}
{%- endcapture -%}

{%- if social_media != blank -%}
  <ul class="social-media social-media--{{ layout | default: 'list' }} unstyled-list" role="list">
    {{- social_media -}}
  </ul>
{%- endif -%}
