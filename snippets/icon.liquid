{%- doc -%}
  Render a specific icon.

  @param {string} icon - the name of the icon to render (passed via the "with" attribute, e.g. {%- render 'icon' with 'cart' -%})
  @param {string} [class] - an optional class to add to the SVG icon
  @param {boolean} [offset] - if set to true, the icon will be offset based on its height on the vertical axis to be aligned with a neighboring element
  @param {boolean} [direction_aware] - if set to true, the icon will be rotated 180deg in RTL context
  @param {number} [width] - an optional width to render the icon (the height will scale accordingly)
  @param {number} [stroke_width] - an optional stroke width to use to replace the default global width
{%- enddoc -%}

{%- assign icon_name = icon | default: name -%}
{%- capture class_attr -%}{{ class }} icon icon-{{ icon_name | handle }} {% if offset %}offset-icon{% endif %} {% if direction_aware %}icon--direction-aware{% endif %}{%- endcapture -%}

{%- if icon_name != blank and icon_name != 'none' -%}
{%- case icon_name -%}
  {%- when 'chevron-down' -%}
    <svg aria-hidden="true" focusable="false" fill="none" width="{{ width | default: 10 }}" class="{{ class_attr | strip }}" viewBox="0 0 10 10">
      <path d="m1 3 4 4 4-4" stroke="currentColor" stroke-linecap="square"/>
    </svg>

  {%- when 'chevron-up' -%}
    <svg aria-hidden="true" focusable="false" fill="none" width="{{ width | default: 10 }}" class="{{ class_attr | strip }}" viewBox="0 0 10 10">
      <path d="M9 7 5 3 1 7" stroke="currentColor" stroke-linecap="square"/>
    </svg>

  {%- when 'chevron-left' -%}
    <svg aria-hidden="true" focusable="false" fill="none" width="{{ width | default: 10 }}" class="{{ class_attr | strip }}" viewBox="0 0 10 10">
      <path d="M7 1 3 5l4 4" stroke="currentColor" stroke-linecap="square"/>
    </svg>

  {%- when 'chevron-right' -%}
    <svg aria-hidden="true" focusable="false" fill="none" width="{{ width | default: 10 }}" class="{{ class_attr | strip }}" viewBox="0 0 10 10">
      <path d="m3 9 4-4-4-4" stroke="currentColor" stroke-linecap="square"/>
    </svg>

  {%- when 'arrow-down' -%}
    <svg aria-hidden="true" focusable="false" fill="none" width="{{ width | default: 18 }}" class="{{ class_attr | strip }}" viewBox="0 0 18 16">
      <path d="m1 4 8 8 8-8" stroke="currentColor" stroke-linecap="square"/>
    </svg>

  {%- when 'arrow-up' -%}
    <svg aria-hidden="true" focusable="false" fill="none" width="{{ width | default: 18 }}" class="{{ class_attr | strip }}" viewBox="0 0 18 16">
      <path d="M17 12 9 4l-8 8" stroke="currentColor" stroke-linecap="square"/>
    </svg>

  {%- when 'arrow-left' -%}
    <svg aria-hidden="true" focusable="false" fill="none" width="{{ width | default: 16 }}" class="{{ class_attr | strip }}" viewBox="0 0 16 18">
      <path d="M11 1 3 9l8 8" stroke="currentColor" stroke-linecap="square"/>
    </svg>

  {%- when 'arrow-right' -%}
    <svg aria-hidden="true" focusable="false" fill="none" width="{{ width | default: 16 }}" class="{{ class_attr | strip }}" viewBox="0 0 16 18">
      <path d="m5 17 8-8-8-8" stroke="currentColor" stroke-linecap="square"/>
    </svg>

  {%- when 'dropdown-chevron' -%}
    <svg aria-hidden="true" focusable="false" fill="none" width="{{ width | default: 10 }}" class="{{ class_attr | strip }}" viewBox="0 0 10 6">
      <path d="m1 1 4 4 4-4" stroke="currentColor" stroke-linecap="square"/>
    </svg>

  {%- when 'minus' -%}
    <svg aria-hidden="true" focusable="false" fill="none" width="{{ width | default: 12 }}" class="{{ class_attr | strip }}" viewBox="0 0 12 12">
      <path d="M0 6h12" stroke="currentColor" stroke-width="{{ stroke_width | default: settings.icon_stroke_width | default: 1.5 }}"/>
    </svg>

