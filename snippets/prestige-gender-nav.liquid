                  <li class="f-mobile-nav__sub-item f-mobile-nav__sub-item--level3"><a href="{{ catalog_url }}" class="f-mobile-nav__sub-link">Caps & Hats</a></li>
                  <li class="f-mobile-nav__sub-item f-mobile-nav__sub-item--level3"><a href="{{ catalog_url }}" class="f-mobile-nav__sub-link">Gloves</a></li>
