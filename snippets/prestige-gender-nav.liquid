                  <li class="f-mobile-nav__sub-item f-mobile-nav__sub-item--level3"><a href="{{ catalog_url }}" class="f-mobile-nav__sub-link">{{ new_5 }}</a></li>
                </ul>
              </div>
            </collapsible-tab>
          </li>
          <li class="f-mobile-nav__subitem f-mobile-nav__sub-item--has-child" data-menu-toggle-item data-collapsible-parent>
            <a href="{{ catalog_url }}" class="f-mobile-nav__sub-link">Clothing</a>
            <collapsible-tab>
