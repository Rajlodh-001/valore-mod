    <a href="{{ catalog_url }}" class="f-site-nav__link focus-inset">
      <span>{{ gender_label }}</span>
    </a>
    <div class="f-site-nav__dropdown f-site-nav__dropdown--level2 f-site-nav__dropdown--mega prestige-mega no-js-hidden color-{{ section.settings.menu_dropdown_color_schema }}" tabindex="-1">
      <div class="container">
        <div class="prestige-mega-menu{% if images_position == 'left' %} prestige-mega-menu--reverse{% endif %}{% if promo_layout == 'wide' %} prestige-mega-menu--wide{% endif %}">
          <ul class="prestige-mega-menu__columns list-none" role="list">
            <li class="prestige-mega-menu__column">
              <a href="{{ catalog_url }}" class="prestige-mega-menu__heading">What's New</a>
              <ul class="prestige-mega-menu__links list-none" role="list">
                <li><a href="{{ catalog_url }}" class="prestige-mega-menu__link">{{ new_1 }}</a></li>
                <li><a href="{{ catalog_url }}" class="prestige-mega-menu__link">{{ new_2 }}</a></li>
                <li><a href="{{ catalog_url }}" class="prestige-mega-menu__link">{{ new_3 }}</a></li>
                <li><a href="{{ catalog_url }}" class="prestige-mega-menu__link">{{ new_4 }}</a></li>
                <li><a href="{{ catalog_url }}" class="prestige-mega-menu__link">{{ new_5 }}</a></li>
              </ul>
            </li>
            <li class="prestige-mega-menu__column">
              <a href="{{ catalog_url }}" class="prestige-mega-menu__heading">Clothing</a>
              <ul class="prestige-mega-menu__links list-none" role="list">
                <li><a href="{{ catalog_url }}" class="prestige-mega-menu__link">{{ cloth_1 }}</a></li>
                <li><a href="{{ catalog_url }}" class="prestige-mega-menu__link">{{ cloth_2 }}</a></li>
                <li><a href="{{ catalog_url }}" class="prestige-mega-menu__link">{{ cloth_3 }}</a></li>
                <li><a href="{{ catalog_url }}" class="prestige-mega-menu__link">{{ cloth_4 }}</a></li>
                <li><a href="{{ catalog_url }}" class="prestige-mega-menu__link">{{ cloth_5 }}</a></li>
              </ul>
            </li>
            <li class="prestige-mega-menu__column">
              <a href="{{ catalog_url }}" class="prestige-mega-menu__heading">Accessories</a>
              <ul class="prestige-mega-menu__links list-none" role="list">
                <li><a href="{{ catalog_url }}" class="prestige-mega-menu__link">Caps & Hats</a></li>
                <li><a href="{{ catalog_url }}" class="prestige-mega-menu__link">Gloves</a></li>
                <li><a href="{{ catalog_url }}" class="prestige-mega-menu__link">Socks</a></li>
                <li><a href="{{ catalog_url }}" class="prestige-mega-menu__link">Musette Bag</a></li>
