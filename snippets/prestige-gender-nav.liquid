{%- doc -%}
  Desktop or mobile Men/Women mega-nav item used when those links are missing from the Shopify menu.
  Labels and collection handles match live Valore; layout stays Prestige.

  @param {string} gender - "men" or "women"
  @param {object} section - header section
  @param {boolean} is_hover - whether dropdowns open on hover
  @param {string} [context] - "desktop" or "mobile"
{%- enddoc -%}

{%- liquid
  assign gender_handle = gender | handleize
  assign gender_label = 'Men'
  assign promo_layout = 'cards'
  assign gender_url = '#'
  assign clothing_url = '#'
  assign accessories_url = '#'
  assign all_collections_url = routes.collections_url | default: '/collections'
  assign new_arrivals_url = collections['new-arrivals'].url | default: '/collections/new-arrivals'

  assign new_1 = 'New Arrivals'
  assign new_2 = 'All Collections'
  assign new_3 = 'Running Singlets'
  assign new_4 = 'Cycling Skinsuits'
  assign new_5 = 'Jacket & Windbreaker'
  assign cloth_1 = 'Cycling Jersey Mens'
  assign cloth_2 = 'Bibs & Shorts'
  assign cloth_3 = 'Vest & Gilet'
  assign cloth_4 = 'Base Layers'
  assign cloth_5 = 'Tights'

  assign new_3_url = collections['running-singlet-mens'].url | default: '/collections/running-singlet-mens'
  assign new_4_url = collections['mens-cycling-skinsuits'].url | default: '/collections/mens-cycling-skinsuits'
  assign new_5_url = collections['jackets'].url | default: '/collections/jackets'
  assign cloth_1_url = collections['cycling-jersey-mens'].url | default: '/collections/cycling-jersey-mens'
  assign cloth_2_url = collections['mens-cycling-bib-shorts'].url | default: '/collections/mens-cycling-bib-shorts'
  assign cloth_3_url = collections['cycling-vest-gilet'].url | default: '/collections/cycling-vest-gilet'
  assign cloth_4_url = collections['cycling-base-layer-mens'].url | default: '/collections/cycling-base-layer-mens'
  assign cloth_5_url = collections['mens-cycling-tights'].url | default: '/collections/mens-cycling-tights'

  if gender_handle == 'women'
    assign gender_label = 'Women'
    assign new_3 = 'Running Singlets Womens'
    assign new_4 = 'Cycling Skinsuits Womens'
    assign new_5 = 'Jackets'
    assign cloth_1 = 'Jerseys'
    assign new_3_url = collections['running-singlet-womens'].url | default: '/collections/running-singlet-womens'
    assign new_4_url = collections['womens-cycling-skinsuits'].url | default: '/collections/womens-cycling-skinsuits'
    assign new_5_url = collections['jackets'].url | default: '/collections/jackets'
    assign cloth_1_url = collections['cycling-jersey-women'].url | default: '/collections/cycling-jersey-women'
    assign cloth_2_url = collections['womens-cycling-bib-shorts'].url | default: '/collections/womens-cycling-bib-shorts'
    assign cloth_3_url = collections['womens-cycling-vest'].url | default: '/collections/womens-cycling-vest'
    assign cloth_4_url = collections['cycling-base-layer-womens'].url | default: '/collections/cycling-base-layer-womens'
    assign cloth_5_url = collections['womens-cycling-tights'].url | default: '/collections/womens-cycling-tights'
  endif

  assign caps_url = collections['cycling-cap-under-helmet'].url | default: '/collections/cycling-cap-under-helmet'
  assign gloves_url = collections['cycling-gloves'].url | default: '/collections/cycling-gloves'
  assign socks_url = collections['cycling-socks'].url | default: '/collections/cycling-socks'
  assign musette_url = collections['musette-bag-cycling'].url | default: '/collections/musette-bag-cycling'
  assign bottles_url = collections['bottles-cups'].url | default: '/collections/bottles-cups'
  assign promo_collection_handle = 'cycling-jersey-mens'

  assign promo_html = ''
  assign images_position = 'right'
  for block in section.blocks
    assign block_heading = block.settings.heading | handleize
    if block_heading == gender_handle
      if block.type == 'mega_menu' or block.type == 'banner'
        assign images_position = block.settings.images_position | default: 'right'
        capture promo_html
          render 'prestige-mega-menu-images', block: block, layout: promo_layout
        endcapture
        break
      endif
    endif
  endfor

  assign promo_heading = 'Cycling jersey'
  assign promo_text = 'Mens'
  assign promo_link = collections['cycling-jersey-mens'].url | default: '/collections/cycling-jersey-mens'
  assign promo_image = collections['cycling-jersey-mens'].featured_image

  if gender_handle == 'women'
    assign promo_text = 'Womens'
    assign promo_link = collections['cycling-jersey-women'].url | default: '/collections/cycling-jersey-women'
    assign promo_image = collections['cycling-jersey-women'].featured_image
    assign promo_collection_handle = 'cycling-jersey-women'
  endif

  assign promo_collection = collections[promo_collection_handle]
  assign promo_product = blank
  if promo_collection != blank and promo_collection.products_count > 0
    assign promo_product = promo_collection.products.first
  endif
%}

{%- if promo_html == blank and promo_image != blank -%}
  {%- capture promo_html -%}
    <a href="{{ promo_link }}" class="prestige-mega-menu__promo-card">
      <div class="prestige-mega-menu__promo-media">
        {{
          promo_image
          | image_url: width: 630
          | image_tag:
            loading: 'lazy',
            widths: '315,630,945',
            sizes: '315px',
            class: 'prestige-mega-menu__promo-img'
        }}
      </div>
      <div class="prestige-mega-menu__promo-caption">
        <p class="prestige-mega-menu__promo-heading">{{ promo_heading }}</p>
        <p class="prestige-mega-menu__promo-text">{{ promo_text }}</p>
      </div>
    </a>
  {%- endcapture -%}
{%- endif -%}

{%- if context == 'mobile' -%}
  <li class="f-mobile-nav__item f-mobile-nav__item--has-child" data-menu-toggle-item data-collapsible-parent>
    <a href="{{ gender_url }}" class="f-mobile-nav__link">{{ gender_label }}</a>
    <collapsible-tab>
      <span class="f-mobile-nav__arrow" data-trigger>
        <span class="no-js-hidden f-mobile-nav__arrow-icon">
          <svg width="2" height="12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 1.333v9.334" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <svg width="2" height="12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 1.333v9.334" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </span>
      <div class="f-mobile-nav__dropdown" data-content>
        <ul class="list-none w-full">
          <li class="f-mobile-nav__subitem f-mobile-nav__sub-item--has-child" data-menu-toggle-item data-collapsible-parent>
            <a href="{{ new_arrivals_url }}" class="f-mobile-nav__sub-link">What's New</a>
            <collapsible-tab>
              <span class="f-mobile-nav__arrow" data-trigger>
                <span class="no-js-hidden f-mobile-nav__arrow-icon">
                  <svg width="2" height="12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 1.333v9.334" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <svg width="2" height="12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 1.333v9.334" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </span>
              <div class="f-mobile-nav__dropdown f-mobile-nav__dropdown--level3" data-content>
                <ul class="list-none">
                  <li class="f-mobile-nav__sub-item f-mobile-nav__sub-item--level3"><a href="{{ new_arrivals_url }}" class="f-mobile-nav__sub-link">{{ new_1 }}</a></li>
                  <li class="f-mobile-nav__sub-item f-mobile-nav__sub-item--level3"><a href="{{ all_collections_url }}" class="f-mobile-nav__sub-link">{{ new_2 }}</a></li>
                  <li class="f-mobile-nav__sub-item f-mobile-nav__sub-item--level3"><a href="{{ new_3_url }}" class="f-mobile-nav__sub-link">{{ new_3 }}</a></li>
                  <li class="f-mobile-nav__sub-item f-mobile-nav__sub-item--level3"><a href="{{ new_4_url }}" class="f-mobile-nav__sub-link">{{ new_4 }}</a></li>
                  <li class="f-mobile-nav__sub-item f-mobile-nav__sub-item--level3"><a href="{{ new_5_url }}" class="f-mobile-nav__sub-link">{{ new_5 }}</a></li>
                </ul>
              </div>
            </collapsible-tab>
          </li>
          <li class="f-mobile-nav__subitem f-mobile-nav__sub-item--has-child" data-menu-toggle-item data-collapsible-parent>
            <a href="{{ clothing_url }}" class="f-mobile-nav__sub-link">Clothing</a>
            <collapsible-tab>
              <span class="f-mobile-nav__arrow" data-trigger>
                <span class="no-js-hidden f-mobile-nav__arrow-icon">
                  <svg width="2" height="12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 1.333v9.334" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <svg width="2" height="12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 1.333v9.334" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </span>
              <div class="f-mobile-nav__dropdown f-mobile-nav__dropdown--level3" data-content>
                <ul class="list-none">
                  <li class="f-mobile-nav__sub-item f-mobile-nav__sub-item--level3"><a href="{{ cloth_1_url }}" class="f-mobile-nav__sub-link">{{ cloth_1 }}</a></li>
                  <li class="f-mobile-nav__sub-item f-mobile-nav__sub-item--level3"><a href="{{ cloth_2_url }}" class="f-mobile-nav__sub-link">{{ cloth_2 }}</a></li>
                  <li class="f-mobile-nav__sub-item f-mobile-nav__sub-item--level3"><a href="{{ cloth_3_url }}" class="f-mobile-nav__sub-link">{{ cloth_3 }}</a></li>
                  <li class="f-mobile-nav__sub-item f-mobile-nav__sub-item--level3"><a href="{{ cloth_4_url }}" class="f-mobile-nav__sub-link">{{ cloth_4 }}</a></li>
                  <li class="f-mobile-nav__sub-item f-mobile-nav__sub-item--level3"><a href="{{ cloth_5_url }}" class="f-mobile-nav__sub-link">{{ cloth_5 }}</a></li>
                </ul>
              </div>
            </collapsible-tab>
          </li>
          <li class="f-mobile-nav__subitem f-mobile-nav__sub-item--has-child" data-menu-toggle-item data-collapsible-parent>
            <a href="{{ accessories_url }}" class="f-mobile-nav__sub-link">Accessories</a>
            <collapsible-tab>
              <span class="f-mobile-nav__arrow" data-trigger>
                <span class="no-js-hidden f-mobile-nav__arrow-icon">
                  <svg width="2" height="12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 1.333v9.334" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <svg width="2" height="12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 1.333v9.334" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </span>
              <div class="f-mobile-nav__dropdown f-mobile-nav__dropdown--level3" data-content>
                <ul class="list-none">
                  <li class="f-mobile-nav__sub-item f-mobile-nav__sub-item--level3"><a href="{{ caps_url }}" class="f-mobile-nav__sub-link">Caps & Hats</a></li>
                  <li class="f-mobile-nav__sub-item f-mobile-nav__sub-item--level3"><a href="{{ gloves_url }}" class="f-mobile-nav__sub-link">Gloves</a></li>
                  <li class="f-mobile-nav__sub-item f-mobile-nav__sub-item--level3"><a href="{{ socks_url }}" class="f-mobile-nav__sub-link">Socks</a></li>
                  <li class="f-mobile-nav__sub-item f-mobile-nav__sub-item--level3"><a href="{{ musette_url }}" class="f-mobile-nav__sub-link">Musette Bag</a></li>
                  <li class="f-mobile-nav__sub-item f-mobile-nav__sub-item--level3"><a href="{{ bottles_url }}" class="f-mobile-nav__sub-link">Bottles & Mugs</a></li>
                </ul>
              </div>
            </collapsible-tab>
          </li>
        </ul>
      </div>
    </collapsible-tab>
  </li>
{%- else -%}
  <li class="f-site-nav__item f-site-nav__item--has-child f-site-nav__item--mega" data-index="{{ gender_handle }}">
    <a href="{{ gender_url }}" class="f-site-nav__link focus-inset">
      <span>{{ gender_label }}</span>
    </a>
    <div class="f-site-nav__dropdown f-site-nav__dropdown--level2 f-site-nav__dropdown--mega prestige-mega no-js-hidden color-{{ section.settings.menu_dropdown_color_schema }}" tabindex="-1">
      <div class="container">
        <div class="prestige-mega-menu{% if images_position == 'left' %} prestige-mega-menu--reverse{% endif %}{% if promo_layout == 'wide' %} prestige-mega-menu--wide{% endif %}">
          <ul class="prestige-mega-menu__columns list-none" role="list">
            <li class="prestige-mega-menu__column">
              <a href="{{ new_arrivals_url }}" class="prestige-mega-menu__heading">What's New</a>
              <ul class="prestige-mega-menu__links list-none" role="list">
                <li><a href="{{ new_arrivals_url }}" class="prestige-mega-menu__link">{{ new_1 }}</a></li>
                <li><a href="{{ all_collections_url }}" class="prestige-mega-menu__link">{{ new_2 }}</a></li>
                <li><a href="{{ new_3_url }}" class="prestige-mega-menu__link">{{ new_3 }}</a></li>
                <li><a href="{{ new_4_url }}" class="prestige-mega-menu__link">{{ new_4 }}</a></li>
                <li><a href="{{ new_5_url }}" class="prestige-mega-menu__link">{{ new_5 }}</a></li>
              </ul>
            </li>
            <li class="prestige-mega-menu__column">
              <a href="{{ clothing_url }}" class="prestige-mega-menu__heading">Clothing</a>
              <ul class="prestige-mega-menu__links list-none" role="list">
                <li><a href="{{ cloth_1_url }}" class="prestige-mega-menu__link">{{ cloth_1 }}</a></li>
                <li><a href="{{ cloth_2_url }}" class="prestige-mega-menu__link">{{ cloth_2 }}</a></li>
                <li><a href="{{ cloth_3_url }}" class="prestige-mega-menu__link">{{ cloth_3 }}</a></li>
                <li><a href="{{ cloth_4_url }}" class="prestige-mega-menu__link">{{ cloth_4 }}</a></li>
                <li><a href="{{ cloth_5_url }}" class="prestige-mega-menu__link">{{ cloth_5 }}</a></li>
              </ul>
            </li>
            <li class="prestige-mega-menu__column">
              <a href="{{ accessories_url }}" class="prestige-mega-menu__heading">Accessories</a>
              <ul class="prestige-mega-menu__links list-none" role="list">
                <li><a href="{{ caps_url }}" class="prestige-mega-menu__link">Caps & Hats</a></li>
                <li><a href="{{ gloves_url }}" class="prestige-mega-menu__link">Gloves</a></li>
                <li><a href="{{ socks_url }}" class="prestige-mega-menu__link">Socks</a></li>
                <li><a href="{{ musette_url }}" class="prestige-mega-menu__link">Musette Bag</a></li>
                <li><a href="{{ bottles_url }}" class="prestige-mega-menu__link">Bottles & Mugs</a></li>
              </ul>
            </li>
          </ul>
          {%- if promo_html != blank -%}
            <div class="prestige-mega-menu__promo{% if promo_layout == 'wide' %} prestige-mega-menu__promo--wide{% endif %}">
              {{- promo_html -}}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </li>
{%- endif -%}
