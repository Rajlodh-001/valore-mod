{% comment %}
  Unique tag: pdp-min-extras
  Metafields: valore_pdp.editorial_image_1/2/3, editorial_caption
{% endcomment %}
{{ 'valore-pdp-minimal.css' | asset_url | stylesheet_tag }}

{% liquid
  assign image_1 = product.metafields.valore_pdp.editorial_image_1.value
  assign image_2 = product.metafields.valore_pdp.editorial_image_2.value
  assign image_3 = product.metafields.valore_pdp.editorial_image_3.value
  assign caption = product.metafields.valore_pdp.editorial_caption.value

  assign image_count = 0
  if image_1 != blank
    assign image_count = image_count | plus: 1
  endif
  if image_2 != blank
    assign image_count = image_count | plus: 1
  endif
  if image_3 != blank
    assign image_count = image_count | plus: 1
  endif

  assign container = section.settings.container
  assign section_id = section.settings.custom_id | default: section.id
%}

{% if image_count > 0 %}
  <div
    id="{{ section_id }}"
    class="valore-pdp-editorial valore-pdp-tag--extras f-section-padding color-{{ section.settings.color_schema }}"
    data-valore-tag="pdp-min-extras"
    data-section-type="valore-pdp-editorial-strip"
    data-section-id="{{ section.id }}"
    style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="{{ container }}">
      <div class="valore-pdp-editorial__grid valore-pdp-editorial__grid--{{ image_count }}">
        {% if image_1 != blank %}
          {% assign editorial_alt_1 = image_1.alt | default: product.title %}
          <figure class="valore-pdp-editorial__item">
            {{
              image_1
              | image_url: width: 2000
              | image_tag:
                loading: 'lazy',
                widths: '550, 750, 1100, 1500, 2000',
                sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                alt: editorial_alt_1
            }}
          </figure>
        {% endif %}
        {% if image_2 != blank %}
          {% assign editorial_alt_2 = image_2.alt | default: product.title %}
          <figure class="valore-pdp-editorial__item">
            {{
              image_2
              | image_url: width: 2000
              | image_tag:
                loading: 'lazy',
                widths: '550, 750, 1100, 1500, 2000',
                sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                alt: editorial_alt_2
            }}
          </figure>
        {% endif %}
        {% if image_3 != blank %}
          {% assign editorial_alt_3 = image_3.alt | default: product.title %}
          <figure class="valore-pdp-editorial__item">
            {{
              image_3
              | image_url: width: 2000
              | image_tag:
                loading: 'lazy',
                widths: '550, 750, 1100, 1500, 2000',
                sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                alt: editorial_alt_3
            }}
          </figure>
        {% endif %}
      </div>
      {% if caption != blank %}
        <p class="valore-pdp-editorial__caption">{{ caption | escape }}</p>
      {% endif %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "PDP editorial strip",
  "class": "valore-pdp-tag--extras",
  "settings": [
    {
      "type": "paragraph",
      "content": "Tag pdp-min-extras. Uses metafields valore_pdp.editorial_image_1/2/3. Hidden when empty."
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "options": [
        {
          "value": "container",
          "label": "Fixed"
        },
        {
          "value": "container-fluid",
          "label": "Stretched"
        },
        {
          "value": "container-full",
          "label": "Full width"
        }
      ],
      "default": "container-full"
    },
    {
      "type": "color_scheme",
      "id": "color_schema",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom ID"
    }
  ],
  "presets": [
    {
      "name": "PDP editorial strip"
    }
  ]
}
{% endschema %}
