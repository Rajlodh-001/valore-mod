{% comment %}
  Unique tag: pdp-min-extras
  Metafields: valore_pdp.fit_fabric, size_guide_table, care_advice, model_image, model_name, model_specs, model_jersey_size, model_shorts_size
{% endcomment %}
{{ 'valore-pdp-minimal.css' | asset_url | stylesheet_tag }}

{% liquid
  assign fit_fabric = product.metafields.valore_pdp.fit_fabric.value
  assign size_guide_table = product.metafields.valore_pdp.size_guide_table.value
  assign care_advice = product.metafields.valore_pdp.care_advice.value
  assign model_img = product.metafields.valore_pdp.model_image.value
  assign model_name = product.metafields.valore_pdp.model_name.value
  assign model_specs = product.metafields.valore_pdp.model_specs.value
  assign model_jersey = product.metafields.valore_pdp.model_jersey_size.value
  assign model_shorts = product.metafields.valore_pdp.model_shorts_size.value

  assign has_content = false
  if fit_fabric != blank or size_guide_table != blank or care_advice != blank
    assign has_content = true
  endif

  assign container = section.settings.container
  assign section_id = section.settings.custom_id | default: section.id
%}

{% if has_content %}
  <div
    id="{{ section_id }}"
    class="valore-pdp-product-guide valore-pdp-tag--extras f-section-padding color-{{ section.settings.color_schema }}"
    data-valore-tag="pdp-min-extras"
    data-section-type="valore-pdp-product-guide"
    data-section-id="{{ section.id }}"
    style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="{{ container }}">
      
      <div class="valore-pdp-product-guide__head">
        <div class="valore-pdp-product-guide__eyebrow">{{ section.settings.eyebrow | default: '04 — Product Guide' | escape }}</div>
        <h3 class="valore-pdp-product-guide__heading">{{ section.settings.heading | default: 'Product Guide' | escape }}</h3>
      </div>

      <div class="valore-pdp-product-guide__accordions">

        {% comment %} 1. Fit & Fabric {% endcomment %}
        {% if fit_fabric != blank %}
          <details class="valore-pdp-product-guide__accordion">
            <summary class="valore-pdp-product-guide__summary">
              <span>Fit & Fabric</span>
              <span class="valore-pdp-product-guide__icon"></span>
            </summary>
            <div class="valore-pdp-product-guide__panel">
              <div class="rte">{{ fit_fabric | newline_to_br }}</div>
            </div>
          </details>
        {% endif %}

        {% comment %} 2. Size Guide {% endcomment %}
        {% if size_guide_table != blank %}
          <details class="valore-pdp-product-guide__accordion">
            <summary class="valore-pdp-product-guide__summary">
              <span>Size guide</span>
              <span class="valore-pdp-product-guide__icon"></span>
            </summary>
            <div class="valore-pdp-product-guide__panel">
              <div class="valore-pdp-product-guide__size-table rte">
                {{ size_guide_table }}
              </div>
              <div class="valore-pdp-product-guide__size-notes">
                <p class="size-guide-note">cm, taken flat, +-1-3 cm.</p>
                <p class="size-guide-note">Still not sure? Email us at <a href="mailto:support@valore.cc" class="link">support@valore.cc</a></p>
              </div>

              {% comment %} Model Information Block {% endcomment %}
              {% if model_img != blank or model_name != blank %}
                <div class="valore-pdp-product-guide__model-info">
                  <h4 class="valore-pdp-product-guide__model-heading">MODEL INFORMATION</h4>
                  <div class="valore-pdp-product-guide__model-grid">
                    {% if model_img != blank %}
                      <div class="valore-pdp-product-guide__model-media">
                        {{ model_img | image_url: width: 400 | image_tag: loading: 'lazy', alt: model_name }}
                      </div>
                    {% endif %}
                    <div class="valore-pdp-product-guide__model-details">
                      {% if model_name != blank %}
                        <div class="valore-pdp-product-guide__model-row">
                          <span class="valore-pdp-product-guide__model-label">MODEL:</span>
                          <span class="valore-pdp-product-guide__model-val">{{ model_name | escape }}</span>
                        </div>
                      {% endif %}
                      {% if model_specs != blank %}
                        <div class="valore-pdp-product-guide__model-row">
                          <span class="valore-pdp-product-guide__model-label">HEIGHT / WEIGHT:</span>
                          <span class="valore-pdp-product-guide__model-val">{{ model_specs | escape }}</span>
                        </div>
                      {% endif %}

                      {% if model_jersey != blank or model_shorts != blank %}
                        <div class="valore-pdp-product-guide__model-row valore-pdp-product-guide__model-row--size">
                          <span class="valore-pdp-product-guide__model-label">WEARING SIZE:</span>
                          {% if model_jersey != blank %}
                            <div class="valore-pdp-product-guide__model-subrow">
                              <span class="valore-pdp-product-guide__model-sublabel">JERSEY</span>
                              <span class="valore-pdp-product-guide__model-subval">{{ model_jersey | escape }}</span>
                            </div>
                          {% endif %}
                          {% if model_shorts != blank %}
                            <div class="valore-pdp-product-guide__model-subrow">
                              <span class="valore-pdp-product-guide__model-sublabel">SHORTS</span>
                              <span class="valore-pdp-product-guide__model-subval">{{ model_shorts | escape }}</span>
                            </div>
                          {% endif %}
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endif %}
            </div>
          </details>
        {% endif %}

        {% comment %} 3. Care Advice {% endcomment %}
        {% if care_advice != blank %}
          <details class="valore-pdp-product-guide__accordion">
            <summary class="valore-pdp-product-guide__summary">
              <span>Care advice</span>
              <span class="valore-pdp-product-guide__icon"></span>
            </summary>
            <div class="valore-pdp-product-guide__panel">
              <div class="valore-pdp-product-guide__care">
                <h4 class="valore-pdp-product-guide__care-title">Washing and Care</h4>
                <p class="valore-pdp-product-guide__care-subtitle">Built for the ride. Care makes it last.</p>
                
                <div class="valore-pdp-product-guide__care-list rte">
                  {{ care_advice | newline_to_br }}
                </div>

                <p class="valore-pdp-product-guide__care-footer">
                  Following care instructions helps maintain fit, fabric performance, and longevity.
                </p>
                <p class="valore-pdp-product-guide__care-footnote">
                  Care is part of performance.
                </p>
              </div>
            </div>
          </details>
        {% endif %}
      </div>

      {% comment %} Shipping & Returns inline list {% endcomment %}
      <div class="valore-pdp-product-guide__meta">
        <ul class="list-none valore-pdp-meta-list">
          {% if section.settings.shipping_text != blank %}
            <li class="valore-pdp-meta-line flex items-center">
              <span class="valore-pdp-meta-line__dash" aria-hidden="true">—</span>
              <span>{{ section.settings.shipping_text | escape }}</span>
            </li>
          {% endif %}
          {% if section.settings.returns_text != blank %}
            <li class="valore-pdp-meta-line flex items-center">
              <span class="valore-pdp-meta-line__dash" aria-hidden="true">—</span>
              <span>{{ section.settings.returns_text | escape }}</span>
            </li>
          {% endif %}
        </ul>
      </div>

    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "PDP product guide",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "04 — Product Guide"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product Guide"
    },
    {
      "type": "textarea",
      "id": "shipping_text",
      "label": "Shipping information",
      "default": "Free shipping on orders over $180. In stock and ready to ship."
    },
    {
      "type": "textarea",
      "id": "returns_text",
      "label": "Returns information",
      "default": "30 days to change your mind - exchange within 30 days of delivery."
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "options": [
        {
          "value": "container",
          "label": "Fixed"
        },
        {
          "value": "container-fluid",
          "label": "Stretched"
        },
        {
          "value": "container-full",
          "label": "Full width"
        }
      ],
      "default": "container"
    },
    {
      "type": "color_scheme",
      "id": "color_schema",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom ID"
    }
  ],
  "presets": [
    {
      "name": "PDP product guide"
    }
  ]
}
{% endschema %}
