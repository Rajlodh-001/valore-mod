<style>
  #shopify-section-{{ section.id }} {
    --before-after-initial-cursor-position: {{ section.settings.cursor_initial_position | default: 50 }}%;
    --before-after-cursor-background: {{ section.settings.cursor_background | default: '#ffffff' }};
  }

  .shopify-section--before-after-image {
    padding-top: 60px;
    padding-bottom: 60px;
    background: #f5f5f5;
    position: relative;
    z-index: 2;
    overflow: hidden !important;
    overflow-x: hidden !important;
    width: 100% !important;
    max-width: 100vw !important;
    box-sizing: border-box !important;
  }
  .before-after__container {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
    overflow: hidden;
  }
  .before-after__header {
    text-align: center;
    margin-bottom: 40px;
  }
  .before-after__subheading {
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 13px;
    font-weight: 500;
    color: #666;
    margin-bottom: 10px;
  }
  .before-after__title {
    font-size: 26px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
    color: #1c1c1c;
    margin: 0;
  }

  before-after,
  .before-after {
    --before-after-cursor-size: 50px;
    --before-after-cursor-position: var(--before-after-initial-cursor-position, 50%);
    -webkit-user-select: none;
    user-select: none;
    touch-action: pan-y !important;
    display: block !important;
    position: relative !important;
    overflow: hidden !important;
    overflow-x: hidden !important;
    width: 100% !important;
    max-width: 100% !important;
    aspect-ratio: 16 / 9 !important;
    max-height: 650px !important;
    cursor: ew-resize;
    background: #e5e5e5;
    box-sizing: border-box !important;
  }
  @media screen and (max-width: 699px) {
    before-after,
    .before-after {
      aspect-ratio: 4 / 3 !important;
    }
  }
  .before-after__before-image,
  .before-after__after-image {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100% !important;
    height: 100% !important;
    max-width: 100% !important;
    max-height: 100% !important;
    overflow: hidden !important;
    pointer-events: none;
    box-sizing: border-box !important;
  }
  .before-after__before-image img,
  .before-after__after-image img {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    max-width: 100% !important;
    max-height: 100% !important;
    object-fit: cover !important;
    display: block !important;
    pointer-events: none;
  }
  .before-after__after-image {
    z-index: 2;
    clip-path: inset(0 0 0 var(--before-after-cursor-position, 50%));
  }
  .before-after__before-image {
    z-index: 1;
  }

  /* Bottom Product Info Overlays (Exact Prestige Styling) */
  .before-after__content-wrapper {
    position: absolute;
    z-index: 10;
    color: #1c1c1c;
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    gap: 4px;
    bottom: 30px;
  }
  .before-after__before-image .before-after__content-wrapper {
    left: 30px;
    text-align: left;
    align-items: flex-start;
  }
  .before-after__after-image .before-after__content-wrapper {
    right: 30px;
    text-align: right;
    align-items: flex-end;
  }
  .before-after__label {
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0;
    color: #1c1c1c;
    line-height: 1.3;
  }
  .before-after__label a {
    color: #1c1c1c;
    text-decoration: none;
  }
  .before-after__link {
    display: inline-block;
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #1c1c1c;
    text-decoration: underline;
    text-underline-offset: 5px;
    margin-top: 4px;
    transition: opacity 0.2s ease;
  }
  .before-after__link:hover {
    opacity: 0.6;
  }

  @media screen and (max-width: 699px) {
    .before-after__content-wrapper {
      bottom: 12px;
      gap: 2px;
    }
    .before-after__before-image .before-after__content-wrapper {
      left: 12px;
    }
    .before-after__after-image .before-after__content-wrapper {
      right: 12px;
    }
    .before-after__label {
      font-size: 10px;
      letter-spacing: 0.08em;
    }
    .before-after__link {
      font-size: 9px;
      letter-spacing: 0.05em;
      margin-top: 2px;
      text-underline-offset: 3px;
    }
  }

  /* Prestige Center Drag Handle (< > arrows circle) */
  .before-after__cursor {
    pointer-events: auto;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--before-after-cursor-position, 50%) - (var(--before-after-cursor-size) / 2));
    width: var(--before-after-cursor-size);
  }
  .before-after__cursor:before {
    content: "";
    background: #ffffff;
    width: 2px;
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--before-after-cursor-size) / 2 - 1px);
    z-index: -1;
    box-shadow: 0 0 6px rgba(0,0,0,0.2);
  }
  .before-after__cursor-circle {
    width: var(--before-after-cursor-size);
    height: var(--before-after-cursor-size);
    border-radius: 50%;
    background: var(--before-after-cursor-background, #ffffff);
    box-shadow: 0 4px 14px rgba(0,0,0,0.15);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .before-after__cursor-circle svg {
    width: 50px;
    height: 50px;
    display: block;
  }
</style>

{%- liquid
  assign before_block = nil
  assign after_block = nil
  for block in section.blocks
    if block.type == 'before' and before_block == nil
      assign before_block = block
    elsif block.type == 'after' and after_block == nil
      assign after_block = block
    endif
  endfor
-%}

<div class="shopify-section--before-after-image">
  <div class="before-after__container">
    {%- if section.settings.subheading != blank or section.settings.title != blank -%}
      <div class="before-after__header">
        {%- if section.settings.subheading != blank -%}
          <div class="before-after__subheading">{{ section.settings.subheading }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="before-after__title">{{ section.settings.title }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <before-after class="before-after before-after--{{ section.settings.cursor_direction | default: 'horizontal' }}" style="--before-after-cursor-position: {{ section.settings.cursor_initial_position | default: 50 }}%;">
      {%- comment -%} BEFORE IMAGE (LEFT) {%- endcomment -%}
      {%- liquid
        assign before_prod = before_block.settings.product
        assign before_title = before_block.settings.text
        if before_title == blank and before_prod != blank
          assign before_title = before_prod.title
        endif
        if before_title == blank
          assign before_title = 'ALMOND GREEN LIÉGÉ'
        endif

        assign before_img = before_block.settings.image
        if before_img == blank and before_prod.featured_image != blank
          assign before_img = before_prod.featured_image
        endif

        assign before_url = before_block.settings.link_url
        if before_url == blank or before_url == '#'
          if before_prod.url != blank
            assign before_url = before_prod.url
          else
            assign before_url = '/collections/all'
          endif
        endif

        assign before_link_text = before_block.settings.link_text | default: 'View product'
      -%}

      <div class="before-after__before-image" {% if before_block %}{{ before_block.shopify_attributes }}{% endif %}>
        {%- if before_img != blank -%}
          {{ before_img | image_url: width: 1200 | image_tag: loading: 'lazy', draggable: false, alt: before_title }}
        {%- else -%}
          <img src="{{ 'essentials-jerseys.jpg' | asset_url }}" alt="{{ before_title }}" loading="lazy" draggable="false" width="1200" height="1200">
        {%- endif -%}

        <div class="before-after__content-wrapper">
          <p class="before-after__label">
            <a href="{{ before_url }}">{{ before_title }}</a>
          </p>
          <a href="{{ before_url }}" class="before-after__link">
            {{ before_link_text }}
          </a>
        </div>
      </div>

      {%- comment -%} AFTER IMAGE (RIGHT) {%- endcomment -%}
      {%- liquid
        assign after_prod = after_block.settings.product
        assign after_title = after_block.settings.text
        if after_title == blank and after_prod != blank
          assign after_title = after_prod.title
        endif
        if after_title == blank
          assign after_title = 'BLUE DENIM LIÉGÉ'
        endif

        assign after_img = after_block.settings.image
        if after_img == blank and after_prod.featured_image != blank
          assign after_img = after_prod.featured_image
        endif

        assign after_url = after_block.settings.link_url
        if after_url == blank or after_url == '#'
          if after_prod.url != blank
            assign after_url = after_prod.url
          else
            assign after_url = '/collections/all'
          endif
        endif

        assign after_link_text = after_block.settings.link_text | default: 'View product'
      -%}

      <div class="before-after__after-image" {% if after_block %}{{ after_block.shopify_attributes }}{% endif %}>
        {%- if after_img != blank -%}
          {{ after_img | image_url: width: 1200 | image_tag: loading: 'lazy', draggable: false, alt: after_title }}
        {%- else -%}
          <img src="{{ 'essentials-bib-shorts.jpg' | asset_url }}" alt="{{ after_title }}" loading="lazy" draggable="false" width="1200" height="1200">
        {%- endif -%}

        <div class="before-after__content-wrapper">
          <p class="before-after__label">
            <a href="{{ after_url }}">{{ after_title }}</a>
          </p>
          <a href="{{ after_url }}" class="before-after__link">
            {{ after_link_text }}
          </a>
        </div>
      </div>

      {%- comment -%} Prestige Center Drag Handle (< > arrows circle) {%- endcomment -%}
      <div class="before-after__cursor" tabindex="0">
        <div class="before-after__cursor-circle">
          <svg role="presentation" focusable="false" fill="none" width="50" height="50" viewBox="0 0 50 50">
            <rect width="50" height="50" rx="25" fill="{{ section.settings.cursor_background | default: '#ffffff' }}"></rect>
            <path d="m19.25 19-6 6 6 6m11.5 0 6-6-6-6" stroke="{{ section.settings.cursor_arrows_color | default: '#000000' }}" stroke-width="1.5" stroke-linecap="square"></path>
          </svg>
        </div>
      </div>
    </before-after>
  </div>
</div>

<script>
  if (!window.customElements.get('before-after')) {
    class BeforeAfterElement extends HTMLElement {
      constructor() {
        super();
        this.isDragging = false;
        this.onPointerMove = this.onPointerMove.bind(this);
        this.onPointerUp = this.onPointerUp.bind(this);
      }

      connectedCallback() {
        this.addEventListener('pointerdown', (e) => {
          if (e.target.tagName === 'A') return;
          this.isDragging = true;
          this.updatePosition(e);
          window.addEventListener('pointermove', this.onPointerMove);
          window.addEventListener('pointerup', this.onPointerUp, { once: true });
        });

        this.addEventListener('touchmove', (e) => {
          if (this.isDragging && e.touches[0]) {
            this.updatePosition(e.touches[0]);
          }
        }, { passive: true });
      }

      onPointerMove(e) {
        if (!this.isDragging) return;
        this.updatePosition(e);
      }

      onPointerUp() {
        this.isDragging = false;
        window.removeEventListener('pointermove', this.onPointerMove);
      }

      updatePosition(e) {
        const rect = this.getBoundingClientRect();
        let pct = ((e.clientX - rect.left) / rect.width) * 100;
        pct = Math.min(Math.max(pct, 0), 100);
        this.style.setProperty('--before-after-cursor-position', pct + '%');
      }
    }

    window.customElements.define('before-after', BeforeAfterElement);
  }
</script>

{% schema %}
{
  "name": "Before / after",
  "class": "shopify-section--before-after-image",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "Separate section with border",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "LE DALIA"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "CHOOSE YOUR COLOUR"
    },
    {
      "type": "select",
      "id": "cursor_direction",
      "label": "Cursor direction",
      "options": [
        { "value": "horizontal", "label": "Horizontal" },
        { "value": "vertical", "label": "Vertical" }
      ],
      "default": "horizontal"
    },
    {
      "type": "range",
      "id": "cursor_initial_position",
      "min": 0,
      "max": 100,
      "unit": "%",
      "label": "Cursor initial position",
      "default": 50
    },
    {
      "type": "color",
      "id": "cursor_background",
      "label": "Cursor background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "cursor_arrows_color",
      "label": "Cursor arrows color",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "before",
      "name": "Before",
      "limit": 1,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image (Optional)"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Custom Product Label (Optional)",
          "default": "ALMOND GREEN LIÉGÉ"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Button text",
          "default": "View product"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Button link"
        }
      ]
    },
    {
      "type": "after",
      "name": "After",
      "limit": 1,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image (Optional)"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Custom Product Label (Optional)",
          "default": "BLUE DENIM LIÉGÉ"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Button text",
          "default": "View product"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Before / after",
      "blocks": [
        {
          "type": "before"
        },
        {
          "type": "after"
        }
      ]
    }
  ]
}
{% endschema %}
