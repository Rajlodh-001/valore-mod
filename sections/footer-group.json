{
  "type": "footer",
  "name": "Footer group",
  "sections": {
    "text-with-icons": {
      "type": "text-with-icons",
      "blocks": {
        "icon-1": {
          "type": "item",
          "settings": {
            "icon": "picto-delivery-truck",
            "title": "FREE SHIPPING",
            "content": "<p>Exclusive deal on orders $180+</p>"
          }
        },
        "icon-2": {
          "type": "item",
          "settings": {
            "icon": "picto-return",
            "title": "EASY REFUND",
            "content": "<p>Within 30 days of purchase</p>"
          }
        },
        "icon-3": {
          "type": "item",
          "settings": {
            "icon": "picto-customer-support",
            "title": "ONLINE SUPPORT",
            "content": "<p>24 hours a day, 7 days a week</p>"
          }
        },
        "icon-4": {
          "type": "item",
          "settings": {
            "icon": "picto-credit-card",
            "title": "FLEXIBLE PAYMENT",
            "content": "<p>Paypal</p>"
          }
        }
      },
      "block_order": [
        "icon-1",
        "icon-2",
        "icon-3",
        "icon-4"
      ],
      "settings": {
        "color_scheme": "scheme-1",
        "separate_section_with_border": false,
        "stack_on_mobile": false,
        "text_alignment": "center"
      }
    },
    "footer": {
      "type": "footer",
      "blocks": {
        "newsletter": {
          "type": "newsletter",
          "settings": {
            "title": "NEWSLETTER",
            "content": "<p>Subscribe to receive updates, access to exclusive deals, and more.</p>"
          }
        },
        "links-shop": {
          "type": "links",
          "settings": {
            "menu": "footer",
            "show_menu_title": true,
            "menu_title": "SHOP",
            "collapse_on_mobile": false
          }
        },
        "links-info": {
          "type": "links",
          "settings": {
            "menu": "brand",
            "show_menu_title": true,
            "menu_title": "INFORMATION",
            "collapse_on_mobile": false
          }
        },
        "text-about": {
          "type": "text",
          "settings": {
            "title": "ABOUT THE SHOP",
            "content": "<p>The story of Léo and Violette, it's ours. We are Léo Dominguez & Violette Polchi. Two Parisian lovers sharing our lives for more than 8 years. Since the early days of our meeting, we always had the dream to develop a project together. Here it is!<br>Thanks to Léo et Violette for allowing us to use their products in this demo store.</p>",
            "enable_follow_on_shop": false
          }
        }
      },
      "block_order": [
        "newsletter",
        "links-shop",
        "links-info",
        "text-about"
      ],
      "settings": {
        "color_scheme": "scheme-1",
        "separate_section_with_border": false,
        "show_social_media": true,
        "show_payment_icons": true,
        "show_powered_by_shopify": true,
        "show_country_selector": true,
        "show_country_name": true,
        "show_country_flag": true,
        "show_locale_selector": false
      }
    }
  },
  "order": [
    "text-with-icons",
    "footer"
  ]
}
