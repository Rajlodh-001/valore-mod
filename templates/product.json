    "1fa24f8a-d231-4188-aace-4cc0966e2b73": {
      "type": "custom-content",
      "blocks": {
        "c13109d9-d361-43a7-9723-c7cfc5fe7fcc": {
          "type": "text",
          "settings": {
            "color_scheme": "",
            "title": "Performance and Innovation",
            "heading_size": "h2",
            "subheading": "",
            "text": "<p>At VALORE, we design cycling apparel for those who push limits. Collaborating with both professional athletes and cycling enthusiasts, we use cutting-edge fabrics and technologies to deliver gear that enhances comfort, aerodynamics, and durability, empowering cyclists at every level.<br/></p>",
            "alignment": "center",
